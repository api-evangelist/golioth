{
  "opencollection": "1.0.0",
  "info": {
    "name": "Golioth Management Access Logs API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "x-api-key",
      "value": "{{x-api-key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Logs",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Logs_GetLatestDeviceActivityLogs",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.golioth.io/v1/projects/:projectId/device-activity-logs",
            "params": [
              {
                "name": "projectId",
                "value": "",
                "type": "path"
              },
              {
                "name": "page",
                "value": "",
                "type": "query"
              },
              {
                "name": "perPage",
                "value": "",
                "type": "query"
              }
            ]
          }
        },
        {
          "info": {
            "name": "Logs_GetLogs",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.golioth.io/v1/projects/:projectId/logs",
            "params": [
              {
                "name": "projectId",
                "value": "",
                "type": "path"
              },
              {
                "name": "deviceId",
                "value": "",
                "type": "query"
              },
              {
                "name": "start",
                "value": "",
                "type": "query"
              },
              {
                "name": "end",
                "value": "",
                "type": "query"
              },
              {
                "name": "module",
                "value": "",
                "type": "query"
              },
              {
                "name": "level",
                "value": "",
                "type": "query"
              },
              {
                "name": "term",
                "value": "",
                "type": "query"
              },
              {
                "name": "tags",
                "value": "",
                "type": "query"
              }
            ]
          }
        }
      ]
    }
  ],
  "bundled": true
}