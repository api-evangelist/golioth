{
  "opencollection": "1.0.0",
  "info": {
    "name": "Golioth Management Access Firmware API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "x-api-key",
      "value": "{{x-api-key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Firmware",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Firmwares_Logs",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.golioth.io/v1/projects/:projectId/firmware/logs",
            "params": [
              {
                "name": "projectId",
                "value": "",
                "type": "path"
              },
              {
                "name": "page",
                "value": "",
                "type": "query"
              },
              {
                "name": "perPage",
                "value": "",
                "type": "query"
              },
              {
                "name": "version",
                "value": "",
                "type": "query"
              },
              {
                "name": "target",
                "value": "",
                "type": "query"
              },
              {
                "name": "state",
                "value": "",
                "type": "query"
              },
              {
                "name": "reason",
                "value": "",
                "type": "query"
              },
              {
                "name": "deviceId",
                "value": "",
                "type": "query"
              },
              {
                "name": "start",
                "value": "",
                "type": "query"
              },
              {
                "name": "end",
                "value": "",
                "type": "query"
              }
            ]
          }
        }
      ]
    }
  ],
  "bundled": true
}