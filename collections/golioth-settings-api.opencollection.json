{
  "opencollection": "1.0.0",
  "info": {
    "name": "Golioth Management Access Settings API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "x-api-key",
      "value": "{{x-api-key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Settings",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Settings_Get",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.golioth.io/v1/projects/:projectId/devices/:deviceId/settings",
            "params": [
              {
                "name": "projectId",
                "value": "",
                "type": "path"
              },
              {
                "name": "deviceId",
                "value": "",
                "type": "path"
              }
            ]
          }
        },
        {
          "info": {
            "name": "Settings_List",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.golioth.io/v1/projects/:projectId/settings",
            "params": [
              {
                "name": "projectId",
                "value": "",
                "type": "path"
              },
              {
                "name": "blueprintId",
                "value": "",
                "type": "query"
              },
              {
                "name": "deviceId",
                "value": "",
                "type": "query"
              }
            ]
          }
        },
        {
          "info": {
            "name": "Settings_Create",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.golioth.io/v1/projects/:projectId/settings",
            "params": [
              {
                "name": "projectId",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          }
        },
        {
          "info": {
            "name": "Settings_Update",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://api.golioth.io/v1/projects/:projectId/settings/:settingId",
            "params": [
              {
                "name": "projectId",
                "value": "",
                "type": "path"
              },
              {
                "name": "settingId",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          }
        },
        {
          "info": {
            "name": "Settings_Update2",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "https://api.golioth.io/v1/projects/:projectId/settings/:settingId",
            "params": [
              {
                "name": "projectId",
                "value": "",
                "type": "path"
              },
              {
                "name": "settingId",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          }
        },
        {
          "info": {
            "name": "Settings_Delete",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.golioth.io/v1/projects/:projectId/settings/:settingId",
            "params": [
              {
                "name": "projectId",
                "value": "",
                "type": "path"
              },
              {
                "name": "settingId",
                "value": "",
                "type": "path"
              }
            ]
          }
        },
        {
          "info": {
            "name": "Settings_ListAllowedSettingsDataTypes",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.golioth.io/v1/settings-data-types"
          }
        }
      ]
    }
  ],
  "bundled": true
}