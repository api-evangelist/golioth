{
  "opencollection": "1.0.0",
  "info": {
    "name": "Golioth Management Access Project Config API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "x-api-key",
      "value": "{{x-api-key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Project Config",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "ProjectConfig_List",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.golioth.io/v1/organizations/:organizationId/projects/:projectId/config",
            "params": [
              {
                "name": "organizationId",
                "value": "",
                "type": "path"
              },
              {
                "name": "projectId",
                "value": "",
                "type": "path"
              }
            ]
          }
        },
        {
          "info": {
            "name": "ProjectConfig_Get",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.golioth.io/v1/organizations/:organizationId/projects/:projectId/config/:settingId",
            "params": [
              {
                "name": "organizationId",
                "value": "",
                "type": "path"
              },
              {
                "name": "projectId",
                "value": "",
                "type": "path"
              },
              {
                "name": "settingId",
                "value": "",
                "type": "path"
              }
            ]
          }
        },
        {
          "info": {
            "name": "ProjectConfig_Set",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://api.golioth.io/v1/organizations/:organizationId/projects/:projectId/config/:settingId",
            "params": [
              {
                "name": "organizationId",
                "value": "",
                "type": "path"
              },
              {
                "name": "projectId",
                "value": "",
                "type": "path"
              },
              {
                "name": "settingId",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          }
        }
      ]
    }
  ],
  "bundled": true
}